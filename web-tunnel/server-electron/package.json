{
  "name": "@webtunnel/server-electron",
  "version": "0.2.0",
  "description": "Web Tunnel server (Electron) — runs outside Iran, receives tunnel calls, does TCP egress",
  "author": "Web Tunnel",
  "private": true,
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "esbuild src/main/main.ts --bundle --outfile=dist/main/main.cjs --platform=node --format=cjs --target=node20 --external:electron --external:@livekit/rtc-node --external:livekit-client && node -e \"require('fs').copyFileSync('src/main/preload.cjs','dist/main/preload.cjs')\"",
    "dev": "pnpm build && electron .",
    "typecheck": "tsc --noEmit",
    "dist:win": "pnpm build && electron-builder --win --config electron-builder.yml",
    "dist:mac": "pnpm build && electron-builder --mac zip --x64 --config electron-builder.yml -c.mac.identity=null"
  },
  "dependencies": {
    "@livekit/rtc-node": "^0.13.25",
    "livekit-client": "^2.18.4"
  },
  "devDependencies": {
    "@webtunnel/client": "workspace:*",
    "@webtunnel/server": "workspace:*",
    "@webtunnel/shared": "workspace:*",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0"
  }
}
